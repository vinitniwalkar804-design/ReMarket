# ---- Backend environment ----
NODE_ENV=development
PORT=5050

MONGODB_URI=mongodb://localhost:27017/smart_second_hand_marketplace

# Generate your own; never commit it. Any 32+ char random value works, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Left empty, development and test boot with a random per-process secret (all
# sessions are invalidated on restart). Production REFUSES to start without a
# real one, and rejects obvious placeholders and short values.
JWT_SECRET=
JWT_EXPIRES_IN=7d

ML_SERVICE_URL=http://localhost:8000

# CORS origin of the Vite dev server (see frontend/vite.config.js). In dev the
# browser only ever calls same-origin /api/*, which Vite proxies to PORT above,
# so this is a fallback for serving the built frontend from another host.
CLIENT_URL=http://localhost:5174

# ---- ML service environment ----
ML_PORT=8000
ML_MONGODB_URI=mongodb://localhost:27017/smart_second_hand_marketplace
ML_MIN_CUSTOMERS=8
